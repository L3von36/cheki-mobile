# Mahtem Cloud API — configuration.
# Copy this file to `.env` (same folder) and fill in the values from
# Plesk → Databases. Nothing else needs editing.

# ── Database (from Plesk → Databases) ──────────────────────────────────
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=REPLACE_WITH_DB_NAME
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── JWT signing secret (optional) ──────────────────────────────────────
# Leave empty to auto-generate one and store it in the `config` table.
# If you set one manually it must be at least 32 characters.
MAHTEM_JWT_SECRET=

# ── Migration from the old Cloudflare service ──────────────────────────
# Existing users of mahtem-api.mahtem.workers.dev are imported automatically
# the first time they sign in here. Set to empty once all users migrated.
MIGRATE_FROM_URL=https://mahtem-api.mahtem.workers.dev

# ── GitHub releases (optional) ─────────────────────────────────────────
# The landing page's release info is fetched from api.github.com, which
# allows only 60 requests/hour per server IP. Set a fine-grained
# personal-access token (no scopes needed for public repos) to raise that
# to 5,000/hour. Leave empty to stay unauthenticated.
GITHUB_TOKEN=

# ── BetterAuth identity layer (v1.19.0) ────────────────────────────────
# Signing secret for BetterAuth sessions. Leave empty to auto-generate one
# into the `config` table (recommended). If set manually: 32+ characters.
BETTER_AUTH_SECRET=

# Canonical public origin of this API (default: https://mahtem.com.et).
# Used as BetterAuth's baseURL — OAuth callbacks and the GitHub device
# flow build their URLs from it. Override for local testing:
# BETTER_AUTH_URL=http://localhost:8080
# Extra origins allowed to call the auth endpoints (comma-separated),
# e.g. a staging site: https://staging.mahtem.com.et
BETTER_AUTH_TRUSTED_ORIGINS=

# BetterAuth SQLite file (default: data/mahtem-auth.sqlite — keep it).
BETTER_AUTH_SQLITE_PATH=

# ── GitHub sign-in (social provider, optional) ─────────────────────────
# Create an OAuth App at https://github.com/settings/developers:
#   * Homepage URL:            https://mahtem.com.et
#   * Authorization callback:  https://mahtem.com.et/api/auth/callback/github
# When both values are set, the app shows "Continue with GitHub"; when
# empty, the app hides the button and sign-in stays email/phone+password.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Local development / testing only ───────────────────────────────────
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=./data/mahtem.sqlite
